# Reference only: Spring Boot does not automatically load .env files.
# Set these in your shell or IntelliJ run configuration. Do not commit real values.
DB_URL=jdbc:mysql://localhost:3306/user_management
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-database-password
DDL_AUTO=update

# Local SMTP capture server. Configure these for your own provider when needed.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@example.test
HR_EMAIL=hr@example.test

# Enable only when provisioning an administrator, then disable and remove the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=