      "delete": {
        "operationId": "deactivateUser",
        "summary": "ADMIN: deactivate a user, revoke tokens, and queue notifications. Repeated calls are idempotent.",
        "responses": {
          "204": {
            "description": "Completed without a response body"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
