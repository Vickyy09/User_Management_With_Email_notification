  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque random token",
        "description": "Use accessToken from login. Only its SHA-256 hash is stored on the server."
      }
    },
    "schemas": {
      "CreateUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^$|^\\+?[0-9 ()-]{7,30}$",
            "nullable": true
          },
          "department": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 72,
            "writeOnly": true,
            "description": "At least 12 Unicode characters, at most 72 UTF-8 bytes; whitespace-only passwords are rejected."
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ]
      },
      "UpdateUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^$|^\\+?[0-9 ()-]{7,30}$",
            "nullable": true
          },
          "department": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePassword": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 72,
            "writeOnly": true,
            "description": "At least 12 Unicode characters, at most 72 UTF-8 bytes; whitespace-only passwords are rejected."
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^$|^\\+?[0-9 ()-]{7,30}$",
            "nullable": true
          },
          "department": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO local date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO local date-time"
          }
        }
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresAt",
          "user"
        ]
      },
      "UserPage": {
