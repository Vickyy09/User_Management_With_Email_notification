    "/api/users/me/password": {
      "put": {
        "operationId": "changePassword",
        "summary": "Verify current password, change it, revoke all tokens, and notify the user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          }
